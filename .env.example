# Only the signed-in operator can request an inventory export.
# Copy to .env; keep your real credentials out of Git. Email setup is in docs/email-setup.md.

APP_URL=http://localhost:8000 # Browser origin of the export tool; it must match the address used to submit the form.
HOST=127.0.0.1 # The export server listens locally by default; change the interface for your hosting setup.
PORT=8000 # Port for the inventory tool, in both development and production startup.
DB_PATH=.data/app.sqlite # Inventory seed rows and export history live in this SQLite file.
ADMIN_PASSWORD= # Set a unique random password of at least 16 characters for the admin operator.
OPERATOR_EMAIL=operator@example.com # Fixed recipient for the CSV export; replace with your own address.
APP_ENV=development # --production sets this to production and disables local email log mode.
MAIL_MODE=sandbox # Capture inventory exports; production sends email, log writes development previews.
MAIL_FROM=sender@example.com # Sender on inventory exports; live sending needs your verified domain.
MAILTRAP_PRODUCTION_TOKEN= # Your transactional sending token for real inventory exports; unused in sandbox.
MAILTRAP_SANDBOX_TOKEN= # API credential allowed to capture inventory.export messages in your test inbox.
MAILTRAP_INBOX_ID= # Numeric inbox identifier from the Sandbox API integration tab.
